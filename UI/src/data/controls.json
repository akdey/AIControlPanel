{
  "version": "1.4.0",
  "categories": [
    { "id": "guardrails", "label": "Guardrails & Moderation", "icon": "ShieldAlert" },
    { "id": "routing", "label": "Traffic & Routing", "icon": "GitFork" },
    { "id": "policy", "label": "Policy & RBAC", "icon": "Lock" },
    { "id": "optimization", "label": "Optimization & Caching", "icon": "Zap" },
    { "id": "sandboxing", "label": "Execution Sandbox", "icon": "Box" }
  ],
  "controls": [
    {
      "id": "ctrl_pii_masking",
      "type": "guardrail_evaluator",
      "name": "PII Masking & Redaction",
      "category": "guardrails",
      "subcategory": "input_safety",
      "description": "Scans context for sensitive entities using Microsoft Presidio and redacts or fakes values.",
      "ioValidation": {
        "allowedInputs": ["prompt_object", "raw_text", "tool_payload"],
        "allowedOutputs": ["sanitized_prompt_object", "redaction_metadata"]
      },
      "ports": {
        "inputs": [{ "id": "in_payload", "label": "Payload In", "type": "prompt_object" }],
        "outputs": [{ "id": "out_sanitized", "label": "Sanitized Out", "type": "sanitized_prompt_object" }]
      },
      "uiForm": {
        "layout": "vertical",
        "fields": [
          {
            "name": "entity_types",
            "label": "Target PII Entities",
            "type": "multi_select",
            "required": true,
            "options": [
              { "label": "Email Address", "value": "EMAIL_ADDRESS" },
              { "label": "Phone Number", "value": "PHONE_NUMBER" },
              { "label": "Credit Card", "value": "CREDIT_CARD" },
              { "label": "US SSN / National ID", "value": "GOV_ID" },
              { "label": "IP Address", "value": "IP_ADDRESS" },
              { "label": "Crypto Wallet", "value": "CRYPTO_ADDRESS" }
            ],
            "defaultValue": ["EMAIL_ADDRESS", "PHONE_NUMBER", "CREDIT_CARD"]
          },
          {
            "name": "masking_strategy",
            "label": "Masking Strategy",
            "type": "radio_group",
            "options": [
              { "label": "Redact with Token (<EMAIL>)", "value": "token" },
              { "label": "Synthetic Data (Faker)", "value": "faker" },
              { "label": "Blackout (***)", "value": "asterisk" }
            ],
            "defaultValue": "token"
          },
          {
            "name": "custom_regex_list",
            "label": "Custom Regex Patterns",
            "type": "tag_input",
            "placeholder": "Add custom regex...",
            "defaultValue": []
          }
        ]
      },
      "runtimeConfig": {
        "engine": "presidio_analyzer",
        "action": "mutate_payload"
      }
    },
    {
      "id": "ctrl_toxicity_checker",
      "type": "metric_evaluator",
      "name": "Toxicity Moderation",
      "category": "guardrails",
      "subcategory": "content_moderation",
      "description": "Calculates multi-dimensional toxicity scores using RoBERTa models.",
      "ioValidation": {
        "allowedInputs": ["prompt_object", "raw_text"],
        "allowedOutputs": ["scored_payload"]
      },
      "ports": {
        "inputs": [{ "id": "in_text", "label": "Input Text", "type": "prompt_object" }],
        "outputs": [
          { "id": "out_pass", "label": "Safe Context", "type": "sanitized_prompt_object" },
          { "id": "out_toxic", "label": "Toxicity Flag", "type": "taint_flag" }
        ]
      },
      "uiForm": {
        "layout": "accordion",
        "fields": [
          {
            "name": "threshold",
            "label": "General Toxicity Threshold",
            "type": "slider",
            "min": 0.0,
            "max": 1.0,
            "step": 0.01,
            "defaultValue": 0.75,
            "helperText": "Scores above this threshold will flag the context."
          },
          {
            "name": "subcategories",
            "label": "Sub-Category Thresholds",
            "type": "group",
            "fields": [
              { "name": "severe_toxicity", "label": "Severe Toxicity", "type": "slider", "min": 0, "max": 1, "step": 0.05, "defaultValue": 0.5 },
              { "name": "threat", "label": "Threat / Violence", "type": "slider", "min": 0, "max": 1, "step": 0.05, "defaultValue": 0.4 },
              { "name": "insult", "label": "Insults / Profanity", "type": "slider", "min": 0, "max": 1, "step": 0.05, "defaultValue": 0.8 }
            ]
          }
        ]
      },
      "runtimeConfig": {
        "engine": "detoxify",
        "action": "append_metadata"
      }
    },
    {
      "id": "ctrl_prompt_injection",
      "type": "guardrail_evaluator",
      "name": "Prompt Injection Defense",
      "category": "guardrails",
      "subcategory": "content_moderation",
      "description": "Detects system prompt override attacks, jailbreaks, and injection attempts.",
      "ioValidation": {
        "allowedInputs": ["prompt_object", "raw_text"],
        "allowedOutputs": ["sanitized_prompt_object", "injection_flag"]
      },
      "ports": {
        "inputs": [{ "id": "in_prompt", "label": "Prompt Input", "type": "prompt_object" }],
        "outputs": [
          { "id": "out_pass", "label": "Clean Output", "type": "sanitized_prompt_object" },
          { "id": "out_injection", "label": "Injection Flag", "type": "taint_flag" }
        ]
      },
      "uiForm": {
        "layout": "vertical",
        "fields": [
          {
            "name": "strict_mode",
            "label": "Enforce Strict Filtering",
            "type": "toggle",
            "defaultValue": true
          }
        ]
      },
      "runtimeConfig": {
        "engine": "prompt_injection",
        "action": "halt_on_detection"
      }
    },
    {
      "id": "ctrl_decision_gate",
      "type": "dynamic_router",
      "name": "Conditional Decision Gate",
      "category": "routing",
      "subcategory": "logic_gates",
      "description": "Evaluates contextual metadata against rule conditions and branches execution paths dynamically.",
      "ioValidation": {
        "allowedInputs": ["scored_payload", "redaction_metadata", "generic_context", "sanitized_prompt_object"],
        "allowedOutputs": ["prompt_object", "halt_signal", "alert_signal"]
      },
      "ports": {
        "inputs": [{ "id": "in_eval", "label": "Evaluated Data", "type": "sanitized_prompt_object" }],
        "outputs": [
          { "id": "out_pass", "label": "Pass Branch", "type": "sanitized_prompt_object" },
          { "id": "out_block", "label": "Block Branch", "type": "security_refusal" }
        ]
      },
      "uiForm": {
        "layout": "vertical",
        "fields": [
          {
            "name": "routing_rules",
            "label": "Routing Conditions",
            "type": "dynamic_rule_builder",
            "defaultValue": [
              {
                "portIdentifier": "out_block",
                "portLabel": "Critical Violation (> 0.90)",
                "outputType": "security_refusal",
                "condition": { ">": [{ "var": "metadata.toxicity" }, 0.9] }
              },
              {
                "portIdentifier": "out_pass",
                "portLabel": "Clean / Allowed (<= 0.90)",
                "outputType": "sanitized_prompt_object",
                "condition": { "<=": [{ "var": "metadata.toxicity" }, 0.9] }
              }
            ]
          }
        ]
      },
      "runtimeConfig": {
        "engine": "decision_gate",
        "action": "branch_flow"
      }
    },
    {
      "id": "ctrl_opa_rbac",
      "type": "policy_enforcer",
      "name": "OPA / Cedar Tool Authorization",
      "category": "policy",
      "subcategory": "access_control",
      "description": "Filters unauthorized tool/MCP manifests before the prompt hits the model.",
      "ioValidation": {
        "allowedInputs": ["prompt_object", "tool_manifest"],
        "allowedOutputs": ["filtered_tool_manifest"]
      },
      "ports": {
        "inputs": [{ "id": "in_tools", "label": "Full Tool Manifest", "type": "tool_manifest" }],
        "outputs": [{ "id": "out_filtered", "label": "Sanitized Manifest", "type": "filtered_tool_manifest" }]
      },
      "uiForm": {
        "layout": "vertical",
        "fields": [
          {
            "name": "policy_engine",
            "label": "Engine Type",
            "type": "dropdown",
            "options": [
              { "label": "Open Policy Agent (Rego)", "value": "OPA" },
              { "label": "AWS Cedar", "value": "CEDAR" }
            ],
            "defaultValue": "OPA"
          },
          {
            "name": "policy_code",
            "label": "Policy Definition",
            "type": "code_editor",
            "language": "rego",
            "defaultValue": "package agent.authz\n\ndefault allow = false\n\nallow {\n    input.action == \"tool:invoke\"\n    input.role == \"support_tier_1\"\n    not input.tool in [\"database_drop\", \"shell_exec\"]\n}"
          },
          {
            "name": "unauthorized_action",
            "label": "Unauthorized Tool Handling",
            "type": "dropdown",
            "options": [
              { "label": "Invisible (Strip from LLM manifest)", "value": "strip_silently" },
              { "label": "Throw 403 Forbidden Error", "value": "fail_closed" }
            ],
            "defaultValue": "strip_silently"
          }
        ]
      },
      "runtimeConfig": {
        "engine": "opa_wasm",
        "action": "filter_manifest"
      }
    },
    {
      "id": "ctrl_sandbox_exec",
      "type": "sandbox_router",
      "name": "Ephemeral Tool Sandbox",
      "category": "sandboxing",
      "subcategory": "microvm",
      "description": "Routes untrusted code execution tools to Firecracker Micro-VM or WASI runtimes.",
      "ioValidation": {
        "allowedInputs": ["tool_payload"],
        "allowedOutputs": ["sandbox_result"]
      },
      "ports": {
        "inputs": [{ "id": "in_code", "label": "Code Execution Request", "type": "tool_payload" }],
        "outputs": [{ "id": "out_res", "label": "Execution Result", "type": "sandbox_result" }]
      },
      "uiForm": {
        "layout": "vertical",
        "fields": [
          {
            "name": "runtime_env",
            "label": "Sandbox Technology",
            "type": "dropdown",
            "options": [
              { "label": "Firecracker Micro-VM (Full Isolation)", "value": "firecracker" },
              { "label": "Wasmtime (WASI WebAssembly)", "value": "wasm" },
              { "label": "gVisor Runsc Container", "value": "gvisor" }
            ],
            "defaultValue": "firecracker"
          },
          {
            "name": "max_timeout_ms",
            "label": "Max Timeout (ms)",
            "type": "number_input",
            "min": 100,
            "max": 30000,
            "defaultValue": 3000
          },
          {
            "name": "network_access",
            "label": "Network Policy",
            "type": "toggle",
            "defaultValue": false,
            "helperText": "Keep disabled to prevent exfiltration."
          },
          {
            "name": "read_only_rootfs",
            "label": "Enforce Read-Only Root Filesystem",
            "type": "toggle",
            "defaultValue": true
          }
        ]
      },
      "runtimeConfig": {
        "engine": "firecracker_api",
        "action": "ephemeral_exec"
      }
    }
  ]
}
