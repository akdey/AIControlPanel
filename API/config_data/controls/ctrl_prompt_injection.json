{
  "id": "ctrl_prompt_injection",
  "type": "guardrails",
  "name": "Prompt Injection & Jailbreak Shield",
  "category": "guardrails",
  "subcategory": "content_moderation",
  "version": "1.0.0",
  "description": "Detects direct jailbreak attacks, system prompt overrides, and roleplay bypasses using DeBERTa ONNX model.",
  "status": "active",
  "active": true,
  "ports": {
    "inputs": [
      { "id": "in_prompt", "label": "Prompt Input", "type": "prompt_object" }
    ],
    "outputs": [
      { "id": "out_pass", "label": "Clean Output", "type": "sanitized_prompt_object" },
      { "id": "out_block", "label": "Injection Flagged", "type": "sanitized_prompt_object" }
    ]
  },
  "uiForm": {
    "layout": "vertical",
    "fields": [
      {
        "name": "strict_mode",
        "label": "Strict Mode Sensitivity",
        "type": "boolean",
        "defaultValue": true,
        "helperText": "Enforce high sensitivity threshold for detecting indirect overrides."
      }
    ]
  },
  "runtimeConfig": {
    "engine": "rebuff_injector",
    "action": "check_injection"
  }
}
