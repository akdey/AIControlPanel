{
  "id": "ctrl_generic_rule_evaluator",
  "type": "routing",
  "name": "Sandboxed Python Expression Evaluator",
  "category": "routing",
  "subcategory": "logic_gates",
  "description": "Evaluates dynamic Python expressions against upstream node outputs and metadata using sandboxed simpleeval.",
  "status": "inactive",
  "active": false,
  "ioValidation": {
    "allowedInputs": ["sanitized_prompt_object"],
    "allowedOutputs": ["sanitized_prompt_object"]
  },
  "ports": {
    "inputs": [{ "id": "in_data", "label": "Data In", "type": "sanitized_prompt_object" }],
    "outputs": [
      { "id": "out_true", "label": "Rule Match Pass", "type": "sanitized_prompt_object" },
      { "id": "out_false", "label": "Rule Mismatch Pass", "type": "sanitized_prompt_object" }
    ]
  },
  "uiForm": {
    "layout": "vertical",
    "fields": [
      {
        "name": "expression",
        "label": "Evaluation Expression",
        "type": "text",
        "defaultValue": "metadata.get('toxicity_score', 0) < 0.75",
        "helperText": "Sandboxed Python boolean expression."
      }
    ]
  },
  "runtimeConfig": {
    "engine": "generic_rule_evaluator",
    "action": "evaluate_expression"
  }
}
