{
  "id": "ctrl_budget_enforcer",
  "type": "finops",
  "name": "Per-Session Spend Ceiling Enforcer",
  "category": "finops",
  "subcategory": "budget_ceiling",
  "description": "Tracks cumulative token cost per session/tenant and halts pipeline execution if accumulated spend exceeds dollar budget limits.",
  "status": "inactive",
  "active": false,
  "ioValidation": {
    "allowedInputs": ["prompt_object"],
    "allowedOutputs": ["sanitized_prompt_object"]
  },
  "ports": {
    "inputs": [{ "id": "in_request", "label": "Request In", "type": "prompt_object" }],
    "outputs": [
      { "id": "out_pass", "label": "Within Budget Pass", "type": "sanitized_prompt_object" },
      { "id": "out_budget_exceeded", "label": "Budget Exceeded Out", "type": "sanitized_prompt_object" }
    ]
  },
  "uiForm": {
    "layout": "vertical",
    "fields": [
      {
        "name": "max_cost_dollar",
        "label": "Max Session Budget ($)",
        "type": "number",
        "defaultValue": 5.0,
        "helperText": "Maximum accumulated spend ceiling allowed per session in USD."
      }
    ]
  },
  "runtimeConfig": {
    "engine": "budget_enforcer",
    "action": "check_session_budget"
  }
}
