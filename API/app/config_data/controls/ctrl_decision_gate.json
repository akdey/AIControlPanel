{
  "id": "ctrl_decision_gate",
  "type": "dynamic_router",
  "name": "Conditional Decision Gate",
  "category": "routing",
  "subcategory": "logic_gates",
  "description": "Evaluates contextual metadata against rule conditions and branches execution paths dynamically.",
  "ioValidation": {
    "allowedInputs": ["scored_payload", "redaction_metadata", "generic_context", "sanitized_prompt_object"],
    "allowedOutputs": ["prompt_object", "halt_signal", "alert_signal"]
  },
  "ports": {
    "inputs": [{ "id": "in_eval", "label": "Evaluated Data", "type": "sanitized_prompt_object" }],
    "outputs": [
      { "id": "out_pass", "label": "Pass Branch", "type": "sanitized_prompt_object" },
      { "id": "out_block", "label": "Block Branch", "type": "security_refusal" }
    ]
  },
  "uiForm": {
    "layout": "vertical",
    "fields": [
      {
        "name": "routing_rules",
        "label": "Routing Conditions",
        "type": "dynamic_rule_builder",
        "defaultValue": [
          {
            "portIdentifier": "out_block",
            "portLabel": "Critical Violation (> 0.90)",
            "outputType": "security_refusal",
            "condition": { ">": [{ "var": "metadata.toxicity" }, 0.9] }
          },
          {
            "portIdentifier": "out_pass",
            "portLabel": "Clean / Allowed (<= 0.90)",
            "outputType": "sanitized_prompt_object",
            "condition": { "<=": [{ "var": "metadata.toxicity" }, 0.9] }
          }
        ]
      }
    ]
  },
  "runtimeConfig": {
    "engine": "decision_gate",
    "action": "branch_flow"
  }
}
