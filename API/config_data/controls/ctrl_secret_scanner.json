{
  "id": "ctrl_secret_scanner",
  "type": "guardrails",
  "name": "Secret & API Key Scanner (detect-secrets)",
  "category": "guardrails",
  "subcategory": "input_safety",
  "description": "Scans prompt payloads using Yelp detect-secrets OSS engine for AWS credentials, Stripe tokens, RSA private keys, and high-entropy API tokens.",
  "status": "active",
  "active": true,
  "ioValidation": {
    "allowedInputs": ["prompt_object"],
    "allowedOutputs": ["sanitized_prompt_object"]
  },
  "ports": {
    "inputs": [{ "id": "in_payload", "label": "Payload In", "type": "prompt_object" }],
    "outputs": [
      { "id": "out_scanned", "label": "Clean Out", "type": "sanitized_prompt_object" },
      { "id": "out_block", "label": "Secret Blocked Out", "type": "sanitized_prompt_object" }
    ]
  },
  "uiForm": {
    "layout": "vertical",
    "fields": [
      {
        "name": "action",
        "label": "Action on Secret Detect",
        "type": "dropdown",
        "defaultValue": "BLOCK",
        "options": [
          { "label": "Halt Pipeline & Block Request (BLOCK)", "value": "BLOCK" },
          { "label": "Redact Secret Tokens (REDACT)", "value": "REDACT" }
        ]
      }
    ]
  },
  "runtimeConfig": {
    "engine": "secret_scanner",
    "action": "scan_secrets"
  }
}
