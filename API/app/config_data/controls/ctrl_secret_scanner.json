{
  "id": "ctrl_secret_scanner",
  "type": "guardrail_evaluator",
  "name": "Secret & API Key Scanner",
  "category": "guardrails",
  "subcategory": "input_safety",
  "description": "Scans prompts and model outputs for accidental exposure of API keys, AWS credentials, SSH keys, and JWT tokens.",
  "status": "enabled",
  "is_enabled": true,
  "ioValidation": {
    "allowedInputs": ["prompt_object", "raw_text", "tool_payload"],
    "allowedOutputs": ["sanitized_prompt_object", "scan_result"]
  },
  "ports": {
    "inputs": [{ "id": "in_payload", "label": "Payload In", "type": "prompt_object" }],
    "outputs": [{ "id": "out_scanned", "label": "Scanned Out", "type": "sanitized_prompt_object" }]
  },
  "uiForm": {
    "layout": "vertical",
    "fields": [
      {
        "name": "action",
        "label": "Action on Secret Detect",
        "type": "dropdown",
        "defaultValue": "BLOCK",
        "options": [
          { "label": "Halt Pipeline & Block Request (BLOCK)", "value": "BLOCK" },
          { "label": "Redact Secret Tokens (REDACT)", "value": "REDACT" }
        ]
      }
    ]
  },
  "runtimeConfig": {
    "engine": "secret_scanner",
    "action": "scan_secrets"
  }
}
