{
  "id": "ctrl_phi_redactor",
  "type": "guardrails",
  "name": "PHI (HIPAA) Compliance Scrubber",
  "category": "guardrails",
  "subcategory": "input_safety",
  "description": "Specialized HIPAA privacy scrubber for Medical Record Numbers (MRN), Health Plan IDs, Diagnoses, and Patient Data.",
  "status": "active",
  "active": true,
  "ioValidation": {
    "allowedInputs": ["prompt_object"],
    "allowedOutputs": ["sanitized_prompt_object"]
  },
  "ports": {
    "inputs": [{ "id": "in_payload", "label": "Payload In", "type": "prompt_object" }],
    "outputs": [
      { "id": "out_scrubbed", "label": "Scrubbed Out", "type": "sanitized_prompt_object" },
      { "id": "out_block", "label": "PHI Blocked Out", "type": "sanitized_prompt_object" }
    ]
  },
  "uiForm": {
    "layout": "vertical",
    "fields": [
      {
        "name": "action",
        "label": "Action on PHI Detect",
        "type": "dropdown",
        "defaultValue": "REDACT",
        "options": [
          { "label": "Redact PHI Data (REDACT)", "value": "REDACT" },
          { "label": "Halt Pipeline & Block Request (BLOCK)", "value": "BLOCK" }
        ]
      }
    ]
  },
  "runtimeConfig": {
    "engine": "phi_redactor",
    "action": "scrub_phi"
  }
}
